@startuml InsureTech_Deployment_To-Be
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

title Deployment Diagram - InsureTech (To-Be: High Availability)

' ============================================================
'  КЛИЕНТ
' ============================================================
Deployment_Node(user_pc, "Компьютер пользователя", "Windows, macOS, Linux") {
    Container(browser, "Браузер", "Chrome, Firefox, Safari")
}

' ============================================================
'  CDN + OBJECT STORAGE (статика)
' ============================================================
Deployment_Node(cdn_provider, "CDN Provider", "Yandex CDN / CloudFront") {
    Container(cdn_cache, "Edge Cache", "Static Assets", "Кэширование JS, CSS, IMG\nдля пользователей из регионов")
}

' ============================================================
'  YANDEX CLOUD
' ============================================================
Deployment_Node(yandex_cloud, "Yandex Cloud", "Region: ru-central1") {

    ContainerDb(s3_static, "Object Storage (S3)", "Static Hosting", "JS, CSS, Images —\nOrigin для CDN")

    Container(alb, "Application Load Balancer", "L7 Balancer", "Распределение трафика по зонам\nSSL Termination\nHealth Check: HTTP GET /healthz, interval 5s")

    ' === NOTE: Выбор конфигурации K8s ===
    note as k8s_note
        **Выбор конфигурации K8s:**
        Используется **один растянутый кластер**
        Kubernetes поверх трёх зон доступности.

        **Обоснование:** При объёме данных 50 GB
        и одном регионе независимые кластеры
        избыточны. Один кластер проще в управлении,
        обеспечивает единую плоскость оркестрации
        и автоматическое перераспределение подов
        при отказе зоны.
    end note

    ' === NOTE: Фейловер-стратегия (клиент ↔ приложение) ===
    note as failover_note
        **Фейловер-стратегия: Active-Active (Warm Standby на уровне БД)**

        1. ALB выполняет **HTTP Health Check** каждые 5 сек.
        2. При отказе зоны ALB исключает недоступные поды
           из пула за **~15 сек** (3 failed checks).
        3. Kubernetes **автоматически** перезапускает поды
           в оставшихся зонах (Self-Healing).
        4. Клиент **не замечает** отказа — ALB прозрачно
           перенаправляет трафик в здоровые зоны.

        **Итого:** RTO приложения ~15 сек, RTO БД < 2 мин.
    end note

    ' === NOTE: Решение по шардированию ===
    note as sharding_note
        **Шардирование БД: НЕ применяется**

        Текущий объём данных — 50 GB.
        Это укладывается в возможности
        одного кластера PostgreSQL.
        Шардирование создаст избыточную
        сложность без выигрыша.
        Решение будет пересмотрено
        при росте данных > 500 GB.
    end note

    ' --- Availability Zone A ---
    Deployment_Node(zone_a, "Зона доступности A (ru-central1-a)") {
        Deployment_Node(k8s_node_a, "K8s Node A") {
            Container(app_pod_a, "App Pods", "Docker", "Replica Set\nliveness: /healthz\nreadiness: /ready")
        }
        Deployment_Node(db_vm_a, "DB Host A") {
            ContainerDb(pg_master, "PostgreSQL Primary", "Master", "Read/Write")
        }
    }

    ' --- Availability Zone B ---
    Deployment_Node(zone_b, "Зона доступности B (ru-central1-b)") {
        Deployment_Node(k8s_node_b, "K8s Node B") {
            Container(app_pod_b, "App Pods", "Docker", "Replica Set\nliveness: /healthz\nreadiness: /ready")
        }
        Deployment_Node(db_vm_b, "DB Host B") {
            ContainerDb(pg_replica_1, "PostgreSQL Replica 1", "Sync Standby", "Read-Only / Failover Candidate")
        }
    }

    ' --- Availability Zone C ---
    Deployment_Node(zone_c, "Зона доступности C (ru-central1-c)") {
        Deployment_Node(k8s_node_c, "K8s Node C") {
            Container(app_pod_c, "App Pods", "Docker", "Replica Set\nliveness: /healthz\nreadiness: /ready")
        }
        Deployment_Node(db_vm_c, "DB Host C") {
            ContainerDb(pg_replica_2, "PostgreSQL Replica 2", "Async Standby", "Read-Only / Failover Candidate")
        }
    }

    ContainerDb(s3_backup, "Object Storage (S3)", "Backup", "WAL-логи + Base Backups\nдля PITR")
}

' ============================================================
'  СВЯЗИ
' ============================================================

' --- Клиент ---
Rel(browser, cdn_cache, "Загрузка статики", "HTTPS")
Rel(browser, alb, "API запросы", "HTTPS")

' --- CDN → S3 (origin pull напрямую, минуя ALB) ---
Rel(cdn_cache, s3_static, "Origin Pull", "HTTPS")

' --- ALB → App Pods (с health check) ---
Rel(alb, app_pod_a, "Route traffic", "HTTP\nHealth Check: GET /healthz")
Rel(alb, app_pod_b, "Route traffic", "HTTP\nHealth Check: GET /healthz")
Rel(alb, app_pod_c, "Route traffic", "HTTP\nHealth Check: GET /healthz")

' --- App Pods → DB (Read/Write Splitting) ---
Rel(app_pod_a, pg_master, "Write", "TCP/5432")
Rel(app_pod_b, pg_master, "Write", "TCP/5432")
Rel(app_pod_c, pg_master, "Write", "TCP/5432")

Rel(app_pod_a, pg_replica_1, "Read", "TCP/5432")
Rel(app_pod_b, pg_replica_1, "Read", "TCP/5432")
Rel(app_pod_c, pg_replica_2, "Read", "TCP/5432")

' --- Репликация ---
Rel(pg_master, pg_replica_1, "Sync Replication", "WAL Streaming")
Rel(pg_master, pg_replica_2, "Async Replication", "WAL Streaming")

' --- Бэкапы ---
Rel(pg_master, s3_backup, "Архивация WAL", "HTTPS")

' ============================================================
'  Привязка notes к элементам
' ============================================================
k8s_note -[hidden]-> zone_a
failover_note -[hidden]-> alb
sharding_note -[hidden]-> pg_master

@enduml
